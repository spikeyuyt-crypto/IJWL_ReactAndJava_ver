<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ijwl_javabackend.mapper.A003SettingsMapper">

    <update id="updateSettings">
    UPDATE user_settings
        <set>
            <if test="dto.fontSize != null">
                font_size = #{dto.fontSize},
            </if>

            <if test="dto.backgroundColor != null">
                background_color = #{dto.backgroundColor},
            </if>
        </set>
            where user_id = #{userId}
    </update>

</mapper>
